# ==============================================================================
# OfferCheck - Environment Configuration (.env.example)
# Copy to .env for local development
# ==============================================================================

# Application
APP_NAME=OfferCheck
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/v1
SECRET_KEY=change-me-to-a-secure-random-32-character-secret-key-in-prod
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL)
POSTGRES_USER=offercheck_user
POSTGRES_PASSWORD=offercheck_secure_password
POSTGRES_DB=offercheck_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://offercheck_user:offercheck_secure_password@localhost:5432/offercheck_db
DATABASE_SYNC_URL=postgresql://offercheck_user:offercheck_secure_password@localhost:5432/offercheck_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AWS S3 (for raw .eml storage with 30-day lifecycle)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=offercheck-eml-storage

# External APIs
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key
RDAP_BASE_URL=https://rdap.org/domain/

# Rate Limiting & Security
MAX_PAYLOAD_SIZE_KB=200
RATE_LIMIT_PER_MINUTE=30

